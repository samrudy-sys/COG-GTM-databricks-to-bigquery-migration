  "findings": [
    {
      "severity": "medium",
      "unit": "forecastaccuracy",
      "kind": "semantic_trap",
      "detail": "Spark date_trunc('week') is Monday-based; BigQuery DATE_TRUNC(.., WEEK) is Sunday-based -> use WEEK(MONDAY)."
    },
    {
      "severity": "high",
      "unit": "inventoryhealth",
      "kind": "race_condition",
      "detail": "PL_RSI_InventoryHealth reads pds_rsi.silver_sales produced by PL_RSI_SalesDaily but the master pipeline runs them in parallel (no dependsOn). Target DAG must add salesdaily >> inventoryhealth."
    },
    {
      "severity": "medium",
      "unit": "mediaroi",
      "kind": "semantic_trap",
      "detail": "Spark date_trunc('week') is Monday-based; BigQuery DATE_TRUNC(.., WEEK) is Sunday-based -> use WEEK(MONDAY)."
    },
    {
      "severity": "medium",
      "unit": "pricefeatures",
      "kind": "semantic_trap",
      "detail": "Spark date_trunc('week') is Monday-based; BigQuery DATE_TRUNC(.., WEEK) is Sunday-based -> use WEEK(MONDAY)."
    },
    {
      "severity": "medium",
      "unit": "productdim",
      "kind": "python_udf",
      "detail": "Python UDFs must be rewritten as BigQuery SQL expressions (or SQL UDFs)."
    }
