{
    "name": "PL_RSI_OTIF",
    "properties": {
        "description": "On-time-in-full KPIs, fan-out per region",
        "activities": [
            {
                "name": "ForEach_Region",
                "type": "ForEach",
                "dependsOn": [],
                "userProperties": [],
                "typeProperties": {
                    "items": {
                        "value": "@pipeline().parameters.regions",
                        "type": "Expression"
                    },
                    "isSequential": false,
                    "batchCount": 3,
                    "activities": [
                        {
                            "name": "Exec_OTIF_Region",
                            "type": "ExecutePipeline",
                            "dependsOn": [],
                            "userProperties": [],
                            "typeProperties": {
                                "pipeline": {
                                    "referenceName": "PL_RSI_OTIF_Region",
                                    "type": "PipelineReference"
                                },
                                "waitOnCompletion": true,
                                "parameters": {
                                    "region": {
                                        "value": "@item()",
                                        "type": "Expression"
                                    },
                                    "run_date": {
                                        "value": "@pipeline().parameters.run_date",
                                        "type": "Expression"
                                    }
                                }
                            }
                        }
                    ]
                }
            },
            {
                "name": "Notify_Failure",
                "type": "WebActivity",
                "dependsOn": [
                    {
                        "activity": "ForEach_Region",
                        "dependencyConditions": [
                            "Failed"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.00:10:00",
                    "retry": 0
                },
                "userProperties": [],
                "typeProperties": {
                    "url": "https://prod-27.westeurope.logic.azure.com:443/workflows/7f3c1e/triggers/manual/paths/invoke",
                    "method": "POST",
                    "headers": {
                        "Content-Type": "application/json"
                    },
                    "body": {
                        "value": "@concat('{\"pipeline\":\"', pipeline().Pipeline, '\",\"runId\":\"', pipeline().RunId, '\",\"product\":\"pds-rsi\",\"severity\":\"P3\"}')",
                        "type": "Expression"
                    }
                }
            }
        ],
        "parameters": {
            "run_date": {
                "type": "string",
                "defaultValue": "2024-04-30"
            },
            "regions": {
                "type": "array",
                "defaultValue": [
                    "UKI",
                    "DACH",
                    "WEU",
                    "SA",
                    "NA",
                    "CEE"
                ]
            }
        },
        "folder": {
            "name": "RSI/SupplyChain"
        },
        "annotations": [
            "product:pds-rsi",
            "owner:rsi-data-eng"
        ]
    }
}
